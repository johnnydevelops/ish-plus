# Android 10 / Waydroid kernel requirements (ish-plus: LineageOS 17.1)
#
# ish-plus boots Debian's prebuilt arm64 kernel (16 KB pages) inside QEMU,
# so this fragment is a *manifest* of what Waydroid/LXC needs and a *guide*
# for building a custom kernel if the Debian stock one lacks a feature.
# Debian's linux-image-arm64-16k (6.12.y) already enables most of these
# as modules; `tools/make-guest-kernel-16k.sh` trims the module tree but
# KEEPS the binderfs, ashmem, zram, memfd and PSI support listed here, by
# adding them to the keep-list in that script.
#
# Verified against:
#   https://docs.kernel.org/admin-guide/android/index.html
#   https://github.com/waydroid/android_kernel_waydroid
#   LineageOS 17.1 (Android 10) vendor_requirements.txt
#
# ---- Android binder (required by Waydroid for IPC) ----
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
# binderfs replaces /dev/binder, /dev/hwbinder, /dev/vndbinder (Android 10+)
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# Backwards-compat path so older user-space finds /dev/binderfs/binder
CONFIG_ANDROID_BINDER_IPC_SELFTEST=n

# ---- ashmem (still used by Android 10 MediaCodec, SurfaceFlinger) ----
# Replaced by memfd in Android 11; LineageOS 17.1 needs both.
CONFIG_ASHMEM=y
CONFIG_MEMFD_CREATE=y

# ---- Pressure Stall Information (lmkd uses it) ----
CONFIG_PSI=y

# ---- Namespaces (LXC container backend for Waydroid) ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_NS=y

# ---- Cgroups v2 + controllers lmkd and Android rely on ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_DEBUG=n
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_BLK_CGROUP=y
CONFIG_SCHED_AUTOGROUP=y

# ---- zram compressed swap (lz4/zstd), runs in Linux's own RAM ----
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=n
CONFIG_ZRAM_MEMORY_TRACKING=n
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y
CONFIG_FRONTSWAP=n

# ---- /dev/fuse for sharing host files into the container ----
CONFIG_FUSE_FS=y

# ---- Network bridge / veth for the LXC container ----
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=n
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y
CONFIG_TUN=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# ---- Overlayfs (Waydroid overlays /system over its image) ----
CONFIG_OVERLAY_FS=y

# ---- Squashfs / ext4 / loop devices (LineageOS system.img/vendor.img) ----
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_LOOP=y

# ---- DRM / virtio-gpu for SurfaceFlinger -> virglrenderer/ANGLE ----
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
# Sw-sync is what Android's HWComposer uses when there is no real fence
CONFIG_SW_SYNC=y

# ---- /dev/uinput for input injection into Waydroid ----
CONFIG_INPUT_UINPUT=y

# ---- binfmt_misc (FEX x86_64 emulation, also used by Android's ART in
#      native-bridge ARM64 hosts) ----
CONFIG_BINFMT_MISC=y

# ---- seccomp-bpf (Android 10 zygote requires it) ----
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HAVE_ARCH_SECCOMP_FILTER=y

# ---- /dev/random, hw_random (SystemProperties read on boot) ----
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
