+bool MVKPhysicalDevice::supportsMeshShaders() {
+	const char* noMesh = getenv("MVK_NO_MESH");
+	if (noMesh && noMesh[0] == '1') { return false; }
+	return supportsMTLGPUFamily(Apple7) || supportsMTLGPUFamily(Mac2);
+}
+
 bool MVKPhysicalDevice::isTier2MetalArgumentBuffers() {
 	return _isUsingMetalArgumentBuffers && (_metalFeatures.argumentBuffersTier >= MTLArgumentBuffersTier2);
 }
