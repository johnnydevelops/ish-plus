+// The size of the buffer an access chain is in. For an array of buffers (a
+// descriptor array), that's the accessed element's: its size is indexed
+// like the buffer in the chain (name[index]... -> nameBufferSize[index]).
+string CompilerMSL::get_robust_buffer_size_expression(uint32_t var_id, const string &chain_expr)
+{
+	auto &var = get<SPIRVariable>(var_id);
+	if (!chain_expr.empty() && is_array(get_variable_data_type(var)))
+	{
+		auto open = chain_expr.find_first_of('[');
+		if (open != string::npos)
+		{
+			int depth = 0;
+			for (size_t i = open; i < chain_expr.size(); i++)
+			{
+				if (chain_expr[i] == '[')
+					depth++;
+				else if (chain_expr[i] == ']' && --depth == 0)
+				{
+					string buffer_expr = chain_expr.substr(0, open);
+					if (buffer_expr.size() >= 2 && buffer_expr[0] == '(' && buffer_expr[1] == '*')
+						buffer_expr = buffer_expr.substr(2);
+					for (auto &c : buffer_expr)
+						if (c == '.')
+							c = '_';
+					return buffer_expr + buffer_size_name_suffix + chain_expr.substr(open, i - open + 1);
+				}
+			}
+		}
+	}
+	return to_buffer_size_expression(var_id);
+}
