From 13ac6d29dc1906a395bad3a76a8aae9117985f2a Mon Sep 17 00:00:00 2001
From: johnnydevelops <83919475+johnnydevelops@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:16:47 +0000
Subject: [PATCH 1/5] util/anon_file: on iOS, fall back to a temporary file

iOS apps without an app group may not create POSIX shared memory.
---
 src/mesa/util/anon_file.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/mesa/util/anon_file.c b/src/mesa/util/anon_file.c
index c3638917..8f7f99ee 100644
--- a/src/mesa/util/anon_file.c
+++ b/src/mesa/util/anon_file.c
@@ -47,6 +47,7 @@
 #endif
 
 #if defined(__APPLE__)
+#include <TargetConditionals.h>
 #ifndef PSHMNAMLEN
 #define PSHMNAMLEN (31)
 #endif
@@ -179,6 +180,20 @@ os_create_anonymous_file(off_t size, const char *debug_name)
      if (errno != EEXIST)
        break;
    }
+#if TARGET_OS_IPHONE
+   /* iOS apps without an app group may not create POSIX shared memory: an
+    * unlinked file in the app's temporary directory instead (iSH+) */
+   if (fd < 0) {
+      const char *dir = getenv("TMPDIR");
+      char template[1024];
+      snprintf(template, sizeof(template), "%s/mesa-shared-XXXXXX", dir ? dir : "/tmp");
+      fd = mkstemp(template);
+      if (fd >= 0) {
+         fcntl(fd, F_SETFD, FD_CLOEXEC);
+         unlink(template);
+      }
+   }
+#endif
 #elif defined(__OpenBSD__)
    char template[] = "/tmp/mesa-XXXXXXXXXX";
    fd = shm_mkstemp(template);
