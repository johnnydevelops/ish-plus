From c307a867c18e8c67f76bb620c30c599a3ed414b2 Mon Sep 17 00:00:00 2001
From: johnnydevelops <83919475+johnnydevelops@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:16:47 +0000
Subject: [PATCH 2/5] vrend: write gl_PointSize on GLES hosts

GLES leaves the size of points undefined unless the last vertex stage
writes gl_PointSize. ANGLE on Metal draws them huge: glamor's core-font
text (drawn as points) became large black blocks. Write 1 (the GL default)
when the guest's shader doesn't set a size.
---
 src/vrend/vrend_shader.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index 39895cec..c4597722 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -2558,6 +2558,14 @@ static void handle_vertex_proc_exit(const struct dump_ctx *ctx,
     if (!ctx->key->gs_present && !ctx->key->tes_present)
        emit_prescale(glsl_strbufs);
 
+    /* GLES leaves the size of points undefined unless the last vertex stage
+     * writes gl_PointSize (desktop GL uses glPointSize, 1 by default); ANGLE
+     * on Metal then draws them huge. Guests that don't set a size per vertex
+     * get 1. */
+    if (ctx->cfg->use_gles && !ctx->has_pointsize_output &&
+        !ctx->key->gs_present && !ctx->key->tes_present)
+       emit_buf(glsl_strbufs, "gl_PointSize = 1.0;\n");
+
     if (ctx->key->vs.fog_fixup_mask)
        emit_fog_fixup_write(ctx, glsl_strbufs);
 }
@@ -5974,6 +5982,8 @@ iter_instruction(struct tgsi_iterate_context *iter,
          emit_clip_dist_movs(ctx, &ctx->glsl_strbufs);
          if (!ctx->key->gs_present) {
             emit_prescale(&ctx->glsl_strbufs);
+            if (ctx->cfg->use_gles && !ctx->has_pointsize_output)
+               emit_buf(&ctx->glsl_strbufs, "gl_PointSize = 1.0;\n");
          }
       } else if (iter->processor.Processor == TGSI_PROCESSOR_FRAGMENT) {
          handle_fragment_proc_exit(ctx, &ctx->glsl_strbufs);
-- 
