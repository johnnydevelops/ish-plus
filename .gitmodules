[submodule "deps/libarchive"]
	path = deps/libarchive
	url = https://github.com/libarchive/libarchive
[submodule "deps/linux"]
	path = deps/linux
	url = https://github.com/ish-app/linux
	update = none
	shallow = true
[submodule "deps/SwiftTerm"]
	path = deps/SwiftTerm
	url = https://github.com/johnnydevelops/SwiftTerm-ishplus.git
	branch = ishplus
[submodule "deps/qemu"]
	path = deps/qemu
	url = https://github.com/johnnydevelops/qemu-ishplus.git
	branch = ishplus
	shallow = true
